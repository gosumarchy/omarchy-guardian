[Unit]
Description=Omarchy Guardian system sweep: what only root can read
Documentation=file:///usr/share/doc/omarchy-guardian/README.md

[Service]
Type=oneshot
# Reads only; writes nothing but its results, and only when the system
# configuration allows the root checks ([sweep] root = "allowed").
ExecStart=/usr/bin/omarchy-guardian sweep-collect --out
StateDirectory=omarchy-guardian
StateDirectoryMode=0755
# Read-only everywhere but its state directory. No private network or /tmp:
# the collector must see the host's sockets (listeners) and the programs
# running from /tmp.
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
# It reads files and other users' processes, and hands its results to a
# group: no other privilege of root is left to it. /dev and /proc stay the
# host's, since programs running from /dev/shm and every process are what
# it looks at; so does /usr/lib/modules, which it checks the loaded modules
# against (ProtectKernelModules would hide it).
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_CHOWN
# It opens no device beyond the standard ones (/dev/null and the like).
DevicePolicy=closed
RestrictAddressFamilies=none
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The system calls of an ordinary service: files, processes, pipes and
# timers for itself and the helpers it runs (pacman, gzip, getcap, each
# under timeout), and chown for its results. Reading another process
# through /proc is a file read, checked against CAP_SYS_PTRACE; the ptrace
# call itself is not needed and is in none of the groups let through. The
# groups named again after ~ are left out of @system-service already;
# naming them keeps them out should that group ever grow. A call outside
# the list fails with "not permitted" instead of killing the collector, so
# that a helper that asks for something unusual costs one check, not all.
SystemCallFilter=@system-service
SystemCallFilter=~@mount @module @reboot @swap @raw-io @clock @cpu-emulation @debug @obsolete
SystemCallErrorNumber=EPERM
# No keys of root's session, and no System V or POSIX message queues of
# the host's.
KeyringMode=private
PrivateIPC=yes
UMask=0077
# A sweep takes minutes; one that hangs is stopped, and the bar says the
# results are old.
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
