#!/bin/sh
set -eu

GUARDIAN=/usr/bin/omarchy-guardian

if [ ! -x "$GUARDIAN" ]; then
    printf '%s\n' "omarchy-guardian is not installed at $GUARDIAN" >&2
    exit 2
fi

# libalpm runs hooks as direct children of pacman after chroot + chdir("/"),
# so the transaction's argv and working directory are read from the parent.
pacman_pid=$PPID
if ! pacman_cwd=$(readlink -f "/proc/$pacman_pid/cwd"); then
    printf '%s\n' "Cannot read the working directory of pacman (pid $pacman_pid)." >&2
    exit 2
fi

# libalpm also moves pacman itself to the root directory while hooks run, and
# keeps its original working directory open to return to it afterwards; that
# open directory is where relative `pacman -U` archive paths were resolved.
# Only an unambiguous one is used; otherwise relative paths are not found
# and the review refuses them.
if [ "$pacman_cwd" = / ]; then
    start_dir=
    for fd in "/proc/$pacman_pid/fd/"*; do
        target=$(readlink -f "$fd" 2>/dev/null) || continue
        [ -d "$target" ] && [ "$target" != / ] || continue
        if [ -z "$start_dir" ]; then
            start_dir=$target
        elif [ "$start_dir" != "$target" ]; then
            start_dir=
            break
        fi
    done
    [ -z "$start_dir" ] || pacman_cwd=$start_dir
fi

if [ "$(id -u)" -eq 0 ]; then
    invoking_user=${SUDO_USER:-${DOAS_USER:-}}
    if [ -z "$invoking_user" ] || [ "$invoking_user" = root ]; then
        printf '%s\n' "Cannot run the Guardian package review as the invoking user." >&2
        exit 2
    fi
    user_home=$(getent passwd "$invoking_user" | cut -d: -f6)
    case $user_home in
        /*) ;;
        *)
            printf '%s\n' "Cannot find the home directory of $invoking_user." >&2
            exit 2
            ;;
    esac
    # The review runs unprivileged and starts from an empty environment
    # without a login shell, so the user's rc files cannot exit early, change
    # PATH or export provider variables. OpenCode still reads the user's own
    # OpenCode config and credentials under HOME. The review insists on a
    # root-owned OpenCode binary, because this gate sits in front of a root
    # transaction.
    exec /usr/bin/runuser -u "$invoking_user" -- /usr/bin/env -i \
        HOME="$user_home" USER="$invoking_user" LOGNAME="$invoking_user" \
        PATH=/usr/bin:/bin LANG=C.UTF-8 \
        "$GUARDIAN" pacman-hook --pacman-pid "$pacman_pid" --cwd "$pacman_cwd"
fi

# Only reachable when the hook is run without root, which pacman never does;
# the end-to-end tests use this branch with an OpenCode from PATH.
exec "$GUARDIAN" pacman-hook --pacman-pid "$pacman_pid" --cwd "$pacman_cwd" --opencode-from-path
