#!/bin/sh
set -eu

GUARDIAN=/usr/bin/omarchy-guardian
REAL_MAKEPKG=/usr/bin/makepkg

if [ ! -x "$GUARDIAN" ]; then
    printf '%s\n' "omarchy-guardian is not installed at $GUARDIAN" >&2
    exit 2
fi

if [ ! -f PKGBUILD ]; then
    printf '%s\n' "Guardian makepkg gate requires a PKGBUILD in the working directory." >&2
    exit 2
fi

# yay calls makepkg several times per package. The gate reviews the recipe
# (PKGBUILD, install scripts, patches) on every call; makepkg's own src/ and
# pkg/ work directories are left out of that review. For a call that runs
# PKGBUILD functions, it also reads the source list, fetches and extracts the
# sources without running any function, and reviews the upstream files that
# run during the build, before handing over to makepkg. The review memory
# remembers the build by the build directory's name (yay names it after the
# package base). .SRCINFO is untrusted input and is not read.
exec "$GUARDIAN" makepkg-gate -- "$REAL_MAKEPKG" "$@"
