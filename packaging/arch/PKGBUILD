# Builds omarchy-guardian from this source checkout. The installer at the
# top of the checkout builds, installs and turns protection on:
#   ./install.sh
# Installing the package alone activates nothing; run
#   omarchy-guardian protect
# to turn on the pacman hook, the AUR gate and the theme & plugin gate.
# The hook is in libalpm's own hook directory, which pacman always reads,
# and lets every transaction through until it is turned on.

pkgname=omarchy-guardian
pkgver=0.9.3
pkgrel=1
pkgdesc='Reviews downloaded source, AUR builds, pacman scriptlets and Omarchy themes before they run'
arch=('x86_64' 'aarch64')
url='https://github.com/gosumarchy/omarchy-guardian'
license=('MIT')
# jq: the plugin gate (guardian-plugin) reads plugin manifests with it and
# stops without it.
depends=('bubblewrap' 'coreutils' 'curl' 'git' 'glibc' 'jq' 'libarchive' 'pacman' 'util-linux')
makedepends=('cargo')
# One of the two reviewers is needed for any review to come out clear; the
# pacman gate only runs a root-owned one, which these packages install.
optdepends=('claude-code: the default AI reviewer (models written claude-code/...)'
            'opencode: the AI reviewer for every other model'
            'gum: the theme and plugin gates ask for a missing URL and for confirmation with it; without it, give the URL and --yes'
            'libnotify: desktop notifications about blocks and about protection that went off'
            'openssh: ssh-keygen, which the upgrade check needs and install.sh uses to verify a release tag signature')
install=omarchy-guardian.install

_root="$startdir/../.."

prepare() {
    cd "$_root"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$_root"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --frozen --release
}

check() {
    cd "$_root"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --frozen --release
}

package() {
    cd "$_root"
    local lib="$pkgdir/usr/lib/omarchy-guardian"

    install -Dm755 "$srcdir/target/release/omarchy-guardian" "$pkgdir/usr/bin/omarchy-guardian"
    install -Dm755 integrations/pacman/guardian-pacman-hook "$lib/guardian-pacman-hook"
    install -Dm755 integrations/yay/guardian-makepkg "$lib/guardian-makepkg"
    install -Dm755 integrations/omarchy/guardian-theme "$lib/guardian-theme"
    install -Dm755 integrations/omarchy/guardian-plugin "$lib/guardian-plugin"
    install -Dm644 integrations/omarchy/omarchy-bash-interceptor.sh "$lib/omarchy-bash-interceptor.sh"
    install -Dm755 integrations/omarchy/install-user-interceptor.sh "$lib/install-user-interceptor.sh"
    # Loaded by the line `protect` adds to ~/.config/hypr/hyprland.lua.
    install -Dm644 integrations/omarchy/hyprland-path.lua "$lib/hyprland-path.lua"
    install -Dm755 integrations/enable-system-hook.sh "$lib/enable-system-hook.sh"
    install -Dm644 integrations/pacman/omarchy-guardian.hook \
        "$pkgdir/usr/share/libalpm/hooks/omarchy-guardian.hook"
    # What enable-system-hook.sh links into /etc/pacman.d/hooks to turn the
    # hook on.
    install -Dm644 integrations/pacman/omarchy-guardian.hook \
        "$pkgdir/usr/share/omarchy-guardian/omarchy-guardian.hook"
    install -Dm644 integrations/omarchy/omarchy-guardian.desktop \
        "$pkgdir/usr/share/applications/omarchy-guardian.desktop"
    install -Dm644 integrations/omarchy/omarchy-guardian-ask.desktop \
        "$pkgdir/usr/share/applications/omarchy-guardian-ask.desktop"
    install -Dm644 integrations/icons/omarchy-guardian.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-guardian.svg"
    install -Dm644 integrations/icons/omarchy-guardian-alert.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-guardian-alert.svg"
    install -Dm644 integrations/icons/omarchy-guardian-off.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-guardian-off.svg"
    install -Dm644 integrations/omarchy/bar-widget/manifest.json \
        "$pkgdir/usr/share/omarchy-guardian/bar-widget/manifest.json"
    install -Dm644 integrations/omarchy/bar-widget/Widget.qml \
        "$pkgdir/usr/share/omarchy-guardian/bar-widget/Widget.qml"
    # The keys release tags are signed with (SECURITY.md). install.sh holds
    # the next checkout against the copy an installed Guardian carries,
    # never against the checkout's own. Without the file nothing is
    # installed, and install.sh says the signature was not checked.
    if [[ -f packaging/allowed_signers ]]; then
        install -Dm644 packaging/allowed_signers \
            "$pkgdir/usr/share/omarchy-guardian/allowed_signers"
    fi
    for unit in omarchy-guardian-sweep.service omarchy-guardian-sweep.timer; do
        install -Dm644 "integrations/systemd/$unit" "$pkgdir/usr/lib/systemd/user/$unit"
    done
    for unit in omarchy-guardian-sweep-collect.service omarchy-guardian-sweep-collect.timer; do
        install -Dm644 "integrations/systemd/$unit" "$pkgdir/usr/lib/systemd/system/$unit"
    done
    # The README links to the pages under docs/ and to SECURITY.md by
    # relative path, so they are installed in the same layout.
    install -Dm644 README.md "$pkgdir/usr/share/doc/omarchy-guardian/README.md"
    install -Dm644 SECURITY.md "$pkgdir/usr/share/doc/omarchy-guardian/SECURITY.md"
    install -Dm644 -t "$pkgdir/usr/share/doc/omarchy-guardian/docs" docs/*.md
    install -Dm644 -t "$pkgdir/usr/share/doc/omarchy-guardian/docs/images" docs/images/*.png
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/omarchy-guardian/LICENSE"
    for wrapper in omarchy omarchy-theme-install omarchy-theme-update omarchy-plugin-add omarchy-plugin-update; do
        install -Dm755 "integrations/omarchy/bin/$wrapper" "$lib/bin/$wrapper"
    done
    # The upgrade check that does not rely on the checkout it is given: it
    # has to be the installed copy, so it is run from here, never from a
    # checkout.
    install -Dm755 integrations/upgrade.sh "$lib/upgrade"
}
